# Copy this file to .env and fill in a key for whichever provider you're
# using: OpenAI, Anthropic, or both. .env is gitignored.
# The keys are read by the Vite dev server only and never reach the browser.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which provider answers when nothing overrides the model:
# openai | anthropic. Left unset, an Anthropic-only setup (no OPENAI_API_KEY
# at all) defaults to Claude; anything else defaults to OpenAI.
# LLM_PROVIDER=anthropic

# Optional. SFL is a bespoke DSL, so instruction-following matters more here
# than speed: a smaller, cheaper model tends to drift toward Mermaid-like
# syntax. These are the flagship tier of each provider's current generation.
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-opus-5

# Optional. Point at a compatible endpoint other than the provider's own.
# Leave unset to use each SDK's default.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional. How hard the model may think before answering. Unset by default,
# since thinking adds latency and billed tokens to every turn.
# OPENAI_REASONING_EFFORT=low
# ANTHROPIC_EFFORT=low
