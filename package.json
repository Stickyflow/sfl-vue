{
  "name": "sfl-vue-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "stickyflow.js in Vue: a model writes SFL and the <stickyflow-diagram> web component renders it.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write src/ server/ *.ts",
    "format:check": "prettier --check src/ server/ *.ts"
  },
  "dependencies": {
    "marked": "^18.0.7",
    "stickyflow": "^0.5.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "openai": "^4.77.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.9"
  }
}
